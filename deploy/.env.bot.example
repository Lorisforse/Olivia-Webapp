# Copiare come /opt/olivia/deploy/.env.bot SUL VPS (non committare mai il file reale).
# Valori tuoi, presi da BotFather (Telegram) e dal provider LLM che usi.

OLIVIA_TELEGRAM_TOKEN=il_tuo_token_telegram
OLIVIA_LLM_API_KEY=la_tua_chiave_llm
OLIVIA_LLM_BASE_URL=url_base_api_llm
OLIVIA_LLM_DEFAULT_MODEL=modello_di_default
