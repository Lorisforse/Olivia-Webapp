# Copiare come /opt/olivia/.env.prod SUL VPS (non committare mai il file reale).
# Il Jenkinsfile lo legge da li' per costruire/lanciare docker-compose.prod.yml.

# Mongo condiviso col bot Telegram (stesso database "olivia").
# "olivia-mongo-db" e' il nome del container avviato da deploy/docker-compose.mongo.yml.
MONGODB_URL=mongodb://olivia:olivia@olivia-mongo-db:27017/olivia?authSource=admin
MONGODB_DB=olivia

# URL pubblico del backend (dominio scelto per la reverse proxy), usato dal
# frontend in fase di BUILD (Vite inietta le env VITE_* nel bundle statico).
VITE_API_URL=https://api.olivia.lorisamato.it
