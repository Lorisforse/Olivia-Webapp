MONGODB_URL=mongodb://olivia:olivia@localhost:27017/olivia?authSource=admin
MONGODB_DB=olivia
DEBUG=true

# Firma dei token di login della dashboard. In produzione va sostituito con un
# valore casuale e segreto: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-cambiami
# Durata della sessione normale (minuti) e di quella con "resta connesso" (giorni)
JWT_EXPIRE_MINUTES=720
JWT_REMEMBER_DAYS=30
